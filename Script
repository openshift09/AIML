# Practical AI + OpenShift PDF Q&A
# Fully free workflow in Python
# ===============================

# Step 0: Install required packages (run once in terminal)
# pip install sentence-transformers pypdf chromadb transformers torch

# -----------------------------
# Step 1: Read PDF
# -----------------------------
from pypdf import PdfReader

pdf_path = "policy.pdf"  # Replace with your PDF file
reader = PdfReader(pdf_path)

# Combine all pages into a single text string
text = ""
for page in reader.pages:
    page_text = page.extract_text()
    if page_text:  # avoid None pages
        text += page_text

print("First 500 characters of PDF:\n", text[:500])

# -----------------------------
# Step 2: Generate embeddings
# -----------------------------
from sentence_transformers import SentenceTransformer

embedding_model = SentenceTransformer("all-MiniLM-L6-v2")
embedding_vector = embedding_model.encode([text])
print("Embedding shape:", embedding_vector.shape)

# -----------------------------
# Step 3: Store embeddings in ChromaDB
# -----------------------------
import chromadb
from chromadb.utils import embedding_functions

client = chromadb.Client()

embedding_fn = embedding_functions.SentenceTransformerEmbeddingFunction(
    model_name="all-MiniLM-L6-v2"
)

# Create or get collection
collection = client.create_collection(
    name="policy_docs",
    get_or_create=True,
    embedding_function=embedding_fn
)

# Add PDF text to collection
collection.add(
    documents=[text],
    metadatas=[{"source": pdf_path}],
    ids=["policy1"]
)

print("PDF added to ChromaDB")

# -----------------------------
# Step 4: Query ChromaDB
# -----------------------------
query_text = "What are the security policies in OpenShift?"

query_result = collection.query(
    query_texts=[query_text],
    n_results=1
)

# Extract top snippet
snippet = query_result['documents'][0][0]
print("\nMost relevant snippet from PDF:\n", snippet[:500])

# -----------------------------
# Step 5: Ask Free Hugging Face LLM
# -----------------------------
from transformers import AutoTokenizer, AutoModelForCausalLM

# CPU-friendly free LLM
model_name = "tiiuae/falcon-7b-instruct"  # small free model
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

# Prepare prompt
prompt = f"Explain this snippet in simple words:\n{snippet}"

# Tokenize and generate output
inputs = tokenizer(prompt, return_tensors="pt")
outputs = model.generate(**inputs, max_new_tokens=150)
answer = tokenizer.decode(outputs[0], skip_special_tokens=True)

print("\nAI Answer:\n", answer)
